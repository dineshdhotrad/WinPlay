<Window
    x:Class="WinPlay.App.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinPlay.App.ViewModels"
    Title="WinPlay">

        <Grid Padding="16,14,16,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
            <FontIcon Glyph="&#xEC15;" FontSize="18" VerticalAlignment="Center" />
            <TextBlock
                Text="WinPlay"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
        </StackPanel>

        <!-- Now Playing. Always present: popping the whole card in and out reflowed the flyout's
             height every time playback started or stopped, so it swaps CONTENT instead. -->
        <Border Grid.Row="1" Padding="12" CornerRadius="{ThemeResource OverlayCornerRadius}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="10"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <Grid>
                        <FontIcon Glyph="&#xEC4F;" FontSize="20"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Visibility="{x:Bind ViewModel.HasNoArt, Mode=OneWay}" />
                        <Border CornerRadius="10">
                            <Image Source="{x:Bind ViewModel.NowPlayingArt, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.NowPlayingTitle, Mode=OneWay}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind ViewModel.HasNowPlaying, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.NowPlayingArtist, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind ViewModel.HasNowPlaying, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind ViewModel.HasNoNowPlaying, Mode=OneWay}">
                        <FontIcon Glyph="&#xE767;" FontSize="14" Opacity="0.5" />
                        <TextBlock Text="Nothing playing" Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Device list -->
        <Grid Grid.Row="2" MinHeight="120">
            <StackPanel
                Spacing="10"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Visibility="{x:Bind ViewModel.HasNoDevices, Mode=OneWay}">
                <ProgressRing IsActive="True" Width="28" Height="28" />
                <TextBlock
                    Text="Looking for devices…"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="460">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PickerRowViewModel">
                            <StackPanel Margin="0,2">

                                <!-- Speaker / HomePod / stereo pair: the whole row toggles audio -->
                                <ToggleButton
                                    Visibility="{x:Bind IsAudioOnly, Mode=OneWay}"
                                    IsChecked="{x:Bind IsAudioChecked, Mode=TwoWay}"
                                    IsEnabled="{x:Bind IsAudioCapable, Mode=OneWay}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="12,10"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                                    ToolTipService.ToolTip="{x:Bind MembersTooltip, Mode=OneWay}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Any row that is more than one speaker — a stereo pair
                                             or a multi-room group — renders as two layered
                                             speakers, the second behind and dimmed. Depicting the
                                             actual object beats borrowing an unrelated icon: the
                                             two glyphs tried previously for a group drew it as a
                                             crowd of people and as rack hardware. -->
                                        <Grid Grid.Column="0" VerticalAlignment="Center" Width="22" Height="20">
                                            <FontIcon Glyph="{x:Bind PairGlyph, Mode=OneWay}" FontSize="15"
                                                      Opacity="0.55" Margin="0,0,9,4"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="{x:Bind HasPairGlyph, Mode=OneWay}" />
                                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="18"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Grid Grid.Column="2" VerticalAlignment="Center">
                                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind IsBusy, Mode=OneWay}" Visibility="{x:Bind IsBusy, Mode=OneWay}" />
                                            <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind ShowAudioCheck, Mode=OneWay}" />
                                        </Grid>
                                    </Grid>
                                </ToggleButton>

                                <!-- Apple TV: ONE mode, never two. Screen+Audio is a single mirror
                                     session carrying both on one clock — the only arrangement where
                                     picture and sound stay in sync. Two independent switches could
                                     start two sessions on two clocks, so that state is unreachable
                                     rather than merely discouraged. -->
                                <StackPanel Visibility="{x:Bind CanMirror, Mode=OneWay}" Padding="12,10" Spacing="10"
                                    ToolTipService.ToolTip="{x:Bind MembersTooltip, Mode=OneWay}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="18" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind DisplayName, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <ProgressRing Grid.Column="2" Width="16" Height="16" VerticalAlignment="Center"
                                                      IsActive="{x:Bind IsBusy, Mode=OneWay}" Visibility="{x:Bind IsBusy, Mode=OneWay}"
                                                      AutomationProperties.Name="Connecting" />
                                    </Grid>
                                    <Grid Margin="32,0,0,0" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                      CornerRadius="{ThemeResource ControlCornerRadius}" Padding="0,8"
                                                      IsChecked="{x:Bind IsAudioOnlySelected, Mode=OneWay}"
                                                      IsEnabled="{x:Bind IsModeSelectorEnabled, Mode=OneWay}"
                                                      Click="{x:Bind OnAudioOnlyClicked}" AutomationProperties.Name="Audio only">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE767;" FontSize="13" />
                                                <TextBlock Text="Audio" Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                      CornerRadius="{ThemeResource ControlCornerRadius}" Padding="0,8"
                                                      IsChecked="{x:Bind IsScreenOnlySelected, Mode=OneWay}"
                                                      IsEnabled="{x:Bind IsModeSelectorEnabled, Mode=OneWay}"
                                                      Click="{x:Bind OnScreenOnlyClicked}" AutomationProperties.Name="Screen only, no sound">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="{x:Bind MirrorGlyph}" FontSize="13" />
                                                <TextBlock Text="Screen" Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                      CornerRadius="{ThemeResource ControlCornerRadius}" Padding="0,8"
                                                      IsChecked="{x:Bind IsBothSelected, Mode=OneWay}"
                                                      IsEnabled="{x:Bind IsModeSelectorEnabled, Mode=OneWay}"
                                                      Click="{x:Bind OnBothClicked}" AutomationProperties.Name="Screen and audio, in sync">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="{x:Bind MirrorGlyph}" FontSize="12" />
                                                <FontIcon Glyph="&#xE767;" FontSize="12" />
                                                <TextBlock Text="Both" Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </Grid>
                                </StackPanel>

                                <!-- Volume (both kinds) when audio is streaming -->
                                <Grid Margin="44,2,12,4" ColumnSpacing="10" Visibility="{x:Bind ShowVolume, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE767;" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1" Value="{x:Bind VolumePercent, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <TextBlock
            Grid.Row="3"
            Text="{x:Bind ViewModel.Status, Mode=OneWay}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextTrimming="CharacterEllipsis" />
        </Grid>
</Window>
