<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WinPlay.Capture</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64;ARM64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Managed Direct3D11 / DXGI / Media Foundation bindings for the screen-capture
         and H.264 encode hot path. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinPlay.Core\WinPlay.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internal capture helpers (recovery/backoff, resolution negotiation) to tests. -->
    <InternalsVisibleTo Include="WinPlay.Capture.Tests" />
  </ItemGroup>

</Project>
